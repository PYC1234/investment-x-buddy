          "type": "string"
        },
        "period": {
          "format": "date",
          "title": "Period",
          "type": "string"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        },
        "unit": {
          "const": "元",
          "default": "元",
          "title": "Unit",
          "type": "string"
        },
        "total_assets": {
          "exclusiveMinimum": 0,
          "title": "Total Assets",
          "type": "number"
